PORT=3001
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (local Homebrew default often has no password)
DATABASE_URL=postgresql://localhost:5432/creative_archive

# Public origin used when building /uploads/... image URLs (local disk fallback)
PUBLIC_BASE_URL=http://localhost:3001

# Cloudinary (preferred for production / Render). When all three are set,
# uploads go to Cloudinary instead of server/uploads/.
# Dashboard → Settings → API Keys (or Quick Start → View API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix inside your Cloudinary media library
CLOUDINARY_FOLDER=creative-archive

# Calendar day for settling daily stats (IETF timezone name)
STATS_TIMEZONE=America/New_York

# Admin login (change these before deploying)
JWT_SECRET=dev-jwt-secret-change-me
ADMIN_USERNAME=
ADMIN_PASSWORD=
