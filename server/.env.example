PORT=3001
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (local Homebrew default often has no password)
DATABASE_URL=postgresql://localhost:5432/creative_archive

# Public origin used when building /uploads/... image URLs
PUBLIC_BASE_URL=http://localhost:3001

# Calendar day for settling daily stats (IETF timezone name)
STATS_TIMEZONE=America/New_York

# Admin login (change these before deploying)
JWT_SECRET=dev-jwt-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
